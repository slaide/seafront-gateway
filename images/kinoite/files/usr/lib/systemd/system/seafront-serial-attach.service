# Attach a (newly appeared) Teensy serial node to the seafront container. Started by udev
# (90-seafront-usb.rules) on every ttyACM add event, including boot coldplug and replug.
#
# Why this is needed: the quadlet's `AddDevice=-/dev/ttyACM0` is evaluated by the systemd
# GENERATOR, which only runs at boot / daemon-reload. If the node didn't exist then (Teensy
# enumerated late, plugged in after boot, or replugged), the generated unit has no --device
# and pyserial inside the container finds no port, while the libusb cameras still work.
# daemon-reload regenerates the unit WITH --device; the restart applies it.
#
# Not RemainAfterExit: the unit must be startable again on the next add event.
[Unit]
Description=Attach Teensy serial device to seafront (regenerate quadlet + restart)
After=seafront.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl daemon-reload
ExecStart=/usr/bin/systemctl try-restart seafront.service
