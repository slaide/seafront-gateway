# Podman quadlet: runs the seafront app container as a system service.
# `systemctl restart seafront` works because quadlet generates seafront.service.
[Unit]
Description=seafront microscope control
After=network-online.target
Wants=network-online.target

[Container]
Image=10.10.0.69:5000/seafront:stable
# Without this quadlet names it `systemd-seafront`; keep `podman exec seafront ...` working.
ContainerName=seafront
PublishPort=8000:8000
# Persistent state on the writable host partition (survives OS upgrades).
# config.json is pushed here by the gateway (scripts/push-config.sh); images land here too.
Volume=/home/pharmbio/seafront:/root/seafront:z
# SEAFRONT_HOME must equal $HOME/seafront (=/root/seafront) — see the app Containerfile.
Environment=SEAFRONT_HOME=/root/seafront
# Profile to run from config.json. Flip to the real profile once hardware is wired.
Environment=SEAFRONT_MICROSCOPE=mocroscope

# ---------------------------------------------------------------------------
# USB + SERIAL PASSTHROUGH. Bind the host's whole /dev and let the device-cgroup rules
# decide what may actually be opened:
#   189 = usb (libusb cameras via /dev/bus/usb), 166 = ttyACM (Teensy CDC-ACM serial)
# /dev is devtmpfs, so nodes that appear or vanish after start (Teensy reset/replug, which
# can also renumber ttyACM0 <-> ttyACM1) show up live in the container. pyserial finds the
# Teensy by globbing /dev/ttyACM*, so it needs those nodes present, not only /dev/bus/usb.
#
# Do NOT go back to AddDevice=-/dev/ttyACMn: quadlet resolves the optional '-' only when
# the unit is generated (boot / daemon-reload). A node absent then is never passed in; a
# node present then but gone at the next start (renumbered) makes podman refuse to start
# ("stat /dev/ttyACM1: no such file or directory").
#
# SELinux: host device nodes keep their labels; seafront-hardware-prep.service sets the
# `container_use_devices` boolean before seafront starts, which lets the container open them.
# ---------------------------------------------------------------------------
Volume=/dev:/dev
# NOTE the quotes: each cgroup-rule value contains spaces, and quadlet splits
# PodmanArgs on whitespace — unquoted, the unit parses into garbage.
PodmanArgs=--device-cgroup-rule='c 189:* rmw' --device-cgroup-rule='c 166:* rmw'

[Service]
Restart=always
RestartSec=5
# Refresh from the gateway registry on start if reachable; keep the local image when offline.
ExecStartPre=-/usr/bin/podman pull 10.10.0.69:5000/seafront:stable

[Install]
WantedBy=multi-user.target default.target
